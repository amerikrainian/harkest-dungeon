<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>DD2A11y</RootNamespace>
    <AssemblyName>DD2A11y</AssemblyName>
    <DebugType>embedded</DebugType>
    <!-- Copies NuGet runtime assemblies (NAudio, the cue engine's own output device) into the
         build output so they deploy beside the plugin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DD2A11y.Core\DD2A11y.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(RepoRoot)third_party\bepinex\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RepoRoot)third_party\bepinex\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.CSharp">
      <HintPath>$(RepoRoot)third_party\mono.csharp\Mono.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IronCrown">
      <HintPath>$(ManagedDir)\IronCrown.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Debug builds deploy straight into the game so `dotnet build` is the whole loop. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)DD2A11y.dll" />
      <DeployFiles Include="$(TargetDir)DD2A11y.Core.dll" />
      <DeployFiles Include="$(TargetDir)NAudio*.dll" />
      <DeployFiles Include="$(RepoRoot)third_party\prism\prism.dll" />
      <DeployFiles Include="$(RepoRoot)third_party\mono.csharp\Mono.CSharp.dll" />
      <LangFiles Include="$(RepoRoot)lang\*.txt" />
      <AudioAssets Include="$(RepoRoot)assets\audio\**\*.wav" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(BepInExDir)\plugins\DD2A11y" ContinueOnError="true" Retries="0" />
    <Copy SourceFiles="@(LangFiles)" DestinationFolder="$(BepInExDir)\plugins\DD2A11y\lang" ContinueOnError="true" Retries="0" Condition="'@(LangFiles)' != ''" />
    <Copy SourceFiles="@(AudioAssets)"
          DestinationFiles="@(AudioAssets->'$(BepInExDir)\plugins\DD2A11y\assets\audio\%(RecursiveDir)%(Filename)%(Extension)')"
          ContinueOnError="true" Retries="0" Condition="'@(AudioAssets)' != ''" />
  </Target>
</Project>
